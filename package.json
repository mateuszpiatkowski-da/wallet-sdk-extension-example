{
  "name": "wallet-sdk-extension-example",
  "version": "1.0.0",
  "description": "wallet-sdk example extension",
  "homepage": "https://github.com/mateuszpiatkowski-da/wallet-sdk-extension-example#readme",
  "bugs": {
    "url": "https://github.com/mateuszpiatkowski-da/wallet-sdk-extension-example/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateuszpiatkowski-da/wallet-sdk-extension-example.git"
  },
  "license": "MIT",
  "author": "Mateusz Piątkowski <mateusz.piatkowski@digitalassset.com>",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "generate:codegen": "rm -rf ./src/codegen && ./scripts/generate-codegen.sh",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "dev": "yarn test:watch",
    "build": "rm -rf ./dist && esbuild ./index.ts --bundle --platform=node --outdir=./dist --sourcemap=external --minify",
    "setup": "yarn generate:codegen && yarn install"
  },
  "dependencies": {
    "@canton-network/core-provider-ledger": "^1.2.3",
    "@canton-network/wallet-sdk": "^1.3.1",
    "execa": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.23.0",
    "vitest": "^2.0.0"
  },
  "workspaces": [
    "./src/codegen/*"
  ],
  "private": true,
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
